# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet Supabase
# (Project Settings → API dans le dashboard Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site déployé (ex. https://colispreuve.vercel.app), sans
# slash final — utilisée pour construire le lien de suivi absolu inclus
# dans la lettre de réclamation générée (voir lib/data/lettre-reclamation.ts).
# En local, laissez vide ou mettez http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Requis pour créer un compte chauffeur (Project Settings → API →
# "service_role" secret — PAS la clé "anon"). Sans préfixe NEXT_PUBLIC_ : ne
# doit jamais être exposée au navigateur. Ne la partagez jamais (chat,
# capture d'écran, dépôt public) — elle contourne totalement la sécurité de
# la base.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (sentry.io) : monitoring d'erreurs production (serveur + client).
# Créez un projet Next.js sur sentry.io → Settings → Client Keys (DSN).
# Sans elle, Sentry.init reçoit dsn=undefined et ne journalise simplement
# rien (pas d'erreur de build).
NEXT_PUBLIC_SENTRY_DSN=
